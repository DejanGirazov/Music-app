{
  "expo": {
    "name": "Tempo",
    "slug": "frontend-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tempo-logo-no-text.png",
    "scheme": "frontendmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/tempo-logo-no-text.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/tempo-logo-no-text.png",
        "monochromeImage": "./assets/images/tempo-logo-no-text.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dejan4577.frontendmobile.dev"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/tempo-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1676e849-7be1-497b-b89f-5e30e252d532"
      }
    }
  }
}
